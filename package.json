{
  "name": "storefront-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Storefront Ops - Production-grade operations platform for e-commerce departments",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspace=apps/web dev",
    "build": "npm run --workspace=apps/web build",
    "start": "npm run --workspace=apps/web start",
    "test": "node --experimental-strip-types --test packages/core/tests/money.test.ts packages/core/tests/inventory.test.ts packages/core/tests/order-machine.test.ts",
    "test:watch": "node --experimental-strip-types --test --watch packages/core/tests/money.test.ts packages/core/tests/inventory.test.ts packages/core/tests/order-machine.test.ts",
    "lint": "npm run --workspace=apps/web lint",
    "typecheck": "npm run typecheck:core && npm run typecheck:web",
    "typecheck:core": "tsc --project packages/core/tsconfig.json --noEmit",
    "typecheck:web": "tsc --project apps/web/tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
